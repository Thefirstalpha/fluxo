<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements minimaux pour le Hardened Runtime macOS.
  Seul le JIT de V8 est autorisé ; pas d'injection DYLD ni de mémoire exécutable non signée.
  Toute nouvelle entrée doit être justifiée dans docs/architecture/securite.md.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
