{
  "name": "fluxo",
  "productName": "Fluxo",
  "version": "0.1.0",
  "private": true,
  "description": "Application de bureau open source pour piloter ses finances personnelles : dépenses, salaires, relevés bancaires et analyses. Local, chiffré, sans compte.",
  "keywords": [
    "finances-personnelles",
    "budget",
    "bulletin-de-salaire",
    "electron",
    "local-first"
  ],
  "license": "MIT",
  "author": {
    "name": "Les contributeurs Fluxo"
  },
  "homepage": "https://github.com/Thefirstalpha/fluxo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thefirstalpha/fluxo.git"
  },
  "bugs": {
    "url": "https://github.com/Thefirstalpha/fluxo/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:tests",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:tests": "tsc --noEmit -p tsconfig.web-test.json --composite false && tsc --noEmit -p tsconfig.e2e.json --composite false",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "test:coverage": "node scripts/vitest.mjs run --coverage",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.12.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "allowScripts": {
    "electron": false,
    "electron-winstaller": false,
    "esbuild": false
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@playwright/test": "1.65.1",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "echarts": "6.1.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "lucide-react": "1.74.0",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wouter": "3.13.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  }
}
