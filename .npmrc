# Politique de sécurité de la chaîne d'approvisionnement (npm >= 12).
# Voir docs/architecture/securite.md, section « Chaîne d'approvisionnement ».

# N'installe que des versions publiées depuis plus de 7 jours :
# laisse le temps à l'écosystème de détecter un paquet compromis.
min-release-age=7

# Les scripts d'installation des dépendances sont bloqués par défaut (npm 12).
# Toute dépendance avec un script non revu (champ "allowScripts" du package.json)
# fait échouer l'installation au lieu d'être ignorée silencieusement.
strict-allow-scripts=true

# Pas de dépendances Git ni d'archives distantes hors registre.
allow-git=none
allow-remote=none

# Versions exactes dans package.json (le lockfile reste la source de vérité).
save-exact=true
engine-strict=true
fund=false
